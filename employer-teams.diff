diff --git a/firestore.rules.proposed b/firestore.rules.proposed
new file mode 100644
index 0000000..8899d01
--- /dev/null
+++ b/firestore.rules.proposed
@@ -0,0 +1,221 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+    function isActiveAdmin() {
+      return request.auth != null &&
+        exists(/databases/$(database)/documents/admin_staff/$(request.auth.uid)) &&
+        get(/databases/$(database)/documents/admin_staff/$(request.auth.uid)).data.status == 'active';
+    }
+    function myAdminRoles() {
+      return get(/databases/$(database)/documents/admin_staff/$(request.auth.uid)).data.roles;
+    }
+    function hasTopTier(roles) {
+      return roles != null && roles.hasAny(['Founder', 'Co-Founder', 'Developer']);
+    }
+    function hasMidTier(roles) {
+      return roles != null && roles.hasAny(['Managing Head', 'Technical Head']);
+    }
+
+    // Employer & Team Helpers
+    function isEmployerDoc(uid) {
+      return exists(/databases/$(database)/documents/employers/$(uid));
+    }
+    function getEmployerDoc(uid) {
+      return get(/databases/$(database)/documents/employers/$(uid)).data;
+    }
+    function isActiveEmployer() {
+      return request.auth != null &&
+        isEmployerDoc(request.auth.uid) &&
+        (!('status' in getEmployerDoc(request.auth.uid)) || getEmployerDoc(request.auth.uid).status == 'active') &&
+        (!('banned' in getEmployerDoc(request.auth.uid)) || getEmployerDoc(request.auth.uid).banned == false);
+    }
+    function myCompanyId() {
+      let data = getEmployerDoc(request.auth.uid);
+      return ('companyId' in data && data.companyId != null && data.companyId != '') ? data.companyId : request.auth.uid;
+    }
+    function myCompanyRole() {
+      let data = getEmployerDoc(request.auth.uid);
+      return ('companyRole' in data && data.companyRole != null) ? data.companyRole : 'Owner';
+    }
+    function isCompanyMember(targetCompanyId, legacyOwnerUid) {
+      return isActiveEmployer() && (
+        (targetCompanyId != null && targetCompanyId != '' && myCompanyId() == targetCompanyId) ||
+        (legacyOwnerUid != null && (myCompanyId() == legacyOwnerUid || request.auth.uid == legacyOwnerUid))
+      );
+    }
+    function canEditCompanyJob(resourceData) {
+      return isActiveEmployer() &&
+        (isCompanyMember(resourceData.companyId, resourceData.employerUid)) &&
+        (
+          myCompanyRole() in ['Owner', 'Admin'] ||
+          (myCompanyRole() == 'Recruiter' && resourceData.postedBy == request.auth.uid)
+        );
+    }
+    function canDeleteCompanyJob(targetCompanyId, legacyOwnerUid) {
+      return isCompanyMember(targetCompanyId, legacyOwnerUid) &&
+        myCompanyRole() in ['Owner', 'Admin'];
+    }
+    function isCompanyAdminOrOwner(targetCompanyId) {
+      return isActiveEmployer() &&
+        myCompanyId() == targetCompanyId &&
+        myCompanyRole() in ['Owner', 'Admin'];
+    }
+
+    match /users/{userId} {
+      allow read: if true;
+      allow write: if request.auth != null && request.auth.uid == userId;
+    }
+    match /slugs/{slug} {
+      allow read: if true;
+      allow write: if request.auth != null;
+    }
+
+    // Public company profiles
+    match /companies/{companyId} {
+      // Public read so applicants and visitors can view company profile info
+      allow read: if true;
+      // Creator must be an active Owner initializing their own company
+      allow create: if request.auth != null &&
+        request.auth.uid == companyId &&
+        isActiveEmployer() &&
+        myCompanyRole() == 'Owner' &&
+        (!('verified' in request.resource.data) || request.resource.data.verified == false);
+      // Owners and Admins can edit company profile, but cannot touch verified status
+      allow update: if isActiveAdmin() || (
+        isCompanyAdminOrOwner(companyId) &&
+        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])
+      );
+      allow delete: if false; // Deletions must go through server-side admin
+    }
+
+    match /employers/{userId} {
+      // Restrict read to self, members of the same company, or active admins.
+      allow read: if isActiveAdmin() || (request.auth != null && (
+        request.auth.uid == userId ||
+        (resource != null && isCompanyMember(resource.data.companyId, null))
+      ));
+      // Self-create allowed only when initializing their own company as Owner.
+      allow create: if request.auth != null &&
+        request.auth.uid == userId &&
+        request.resource.data.companyId == userId &&
+        request.resource.data.companyRole == 'Owner' &&
+        (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
+        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
+        (!('banned' in request.resource.data) || request.resource.data.banned == false);
+      // Self-update allowed only if core system fields remain untouched.
+      allow update: if request.auth != null &&
+        request.auth.uid == userId &&
+        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyId', 'companyRole', 'status', 'verified', 'banned']);
+      // No client write path for Owners/Admins to manage other members directly.
+      // Member creation, role promotions/demotions, suspensions, and removals
+      // MUST be executed via server-side API routes using firebase-admin with token verification.
+      allow delete: if false;
+    }
+
+    match /jobs/{jobId} {
+      allow read: if true;
+      allow create: if isActiveAdmin() || (
+        isActiveEmployer() &&
+        myCompanyRole() in ['Owner', 'Admin', 'Recruiter'] &&
+        request.resource.data.companyId == myCompanyId() &&
+        request.resource.data.employerUid == myCompanyId() &&
+        request.resource.data.postedBy == request.auth.uid
+      );
+      allow update: if isActiveAdmin() ||
+        canEditCompanyJob(resource.data) ||
+        // Allow applicant count increment during application submission
+        (request.auth != null &&
+         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicants']) &&
+         request.resource.data.applicants == resource.data.applicants + 1);
+      allow delete: if isActiveAdmin() ||
+        canDeleteCompanyJob(resource.data.companyId, resource.data.employerUid);
+    }
+    match /savedJobs/{docId} {
+      allow read, write: if request.auth != null
+        && request.auth.uid == resource.data.applicantUid;
+      allow create: if request.auth != null
+        && request.auth.uid == request.resource.data.applicantUid;
+    }
+    match /applications/{docId} {
+      allow read: if isActiveAdmin() || (request.auth != null && (
+        request.auth.uid == resource.data.applicantUid ||
+        request.auth.uid == resource.data.employerUid ||
+        isCompanyMember(resource.data.companyId, resource.data.employerUid)
+      ));
+      // Recruiters may update applications for all company jobs
+      allow update: if isActiveAdmin() || (request.auth != null && (
+        request.auth.uid == resource.data.applicantUid ||
+        request.auth.uid == resource.data.employerUid ||
+        (isCompanyMember(resource.data.companyId, resource.data.employerUid) && myCompanyRole() in ['Owner', 'Admin', 'Recruiter'])
+      ));
+      allow create: if request.auth != null
+        && request.auth.uid == request.resource.data.applicantUid;
+      allow delete: if request.auth != null
+        && request.auth.uid == resource.data.applicantUid;
+    }
+    match /projects/{projectId} {
+      allow read: if true;
+      allow create: if isActiveAdmin() || (
+        isActiveEmployer() &&
+        myCompanyRole() in ['Owner', 'Admin', 'Recruiter'] &&
+        request.resource.data.companyId == myCompanyId() &&
+        request.resource.data.employerUid == myCompanyId() &&
+        request.resource.data.postedBy == request.auth.uid
+      );
+      allow update: if isActiveAdmin() ||
+        canEditCompanyJob(resource.data) ||
+        (request.auth != null &&
+         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicants']) &&
+         request.resource.data.applicants == resource.data.applicants + 1);
+      allow delete: if isActiveAdmin() ||
+        canDeleteCompanyJob(resource.data.companyId, resource.data.employerUid);
+    }
+    match /savedProjects/{docId} {
+      allow read, write: if request.auth != null
+        && request.auth.uid == resource.data.applicantUid;
+      allow create: if request.auth != null
+        && request.auth.uid == request.resource.data.applicantUid;
+    }
+    match /conversations/{convId} {
+      allow read, update: if request.auth != null
+        && (request.auth.uid in resource.data.participants || isCompanyMember(resource.data.companyId, null));
+      allow create: if request.auth != null
+        && (request.auth.uid in request.resource.data.participants || (request.resource.data.companyId != null && isCompanyMember(request.resource.data.companyId, null)));
+      match /messages/{msgId} {
+        allow read, create: if request.auth != null && (
+          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants ||
+          isCompanyMember(get(/databases/$(database)/documents/conversations/$(convId)).data.companyId, null)
+        );
+      }
+    }
+    match /notifications/{uid}/items/{notifId} {
+      allow read: if request.auth != null && request.auth.uid == uid;
+      allow write: if request.auth != null;
+    }
+    match /helpMessages/{msgId} {
+      allow read: if isActiveAdmin() || (request.auth != null && request.auth.uid == resource.data.uid);
+      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
+      allow update: if isActiveAdmin();
+    }
+    match /admin_staff/{staffId} {
+      allow read: if true;
+      allow create: if isActiveAdmin() &&
+        (hasTopTier(myAdminRoles()) || hasMidTier(myAdminRoles()));
+      allow update: if isActiveAdmin() && (
+        request.auth.uid == staffId ||
+        hasTopTier(myAdminRoles()) ||
+        (hasMidTier(myAdminRoles()) &&
+          !hasTopTier(resource.data.roles) &&
+          !hasMidTier(resource.data.roles))
+      );
+      allow delete: if isActiveAdmin() &&
+        request.auth.uid != staffId &&
+        (
+          hasTopTier(myAdminRoles()) ||
+          (hasMidTier(myAdminRoles()) &&
+            !hasTopTier(resource.data.roles) &&
+            !hasMidTier(resource.data.roles))
+        );
+    }
+  }
+}
diff --git a/scripts/migrate-employer-teams.mjs b/scripts/migrate-employer-teams.mjs
new file mode 100644
index 0000000..60007cd
--- /dev/null
+++ b/scripts/migrate-employer-teams.mjs
@@ -0,0 +1,316 @@
+#!/usr/bin/env node
+/**
+ * Migration Script: Foundation for Employer Team Management
+ *
+ * Usage:
+ *   node scripts/migrate-employer-teams.mjs --dry-run
+ *   node scripts/migrate-employer-teams.mjs
+ *   node scripts/migrate-employer-teams.mjs --service-account=path/to/serviceAccountKey.json
+ *
+ * What it does (Idempotent - safe to run multiple times):
+ * 1. Backfills "employers" documents:
+ *    - Sets companyId = doc.id (if missing)
+ *    - Sets companyRole = "Owner" (if missing)
+ *    - Sets status = "active" (if missing)
+ * 2. Backfills "companies" collection:
+ *    - Creates companies/{companyId} copying ONLY public company-level fields:
+ *      (company, website, logo/profilePicture, description, industry, location, verified)
+ *    - Never copies personal fields (firstName, lastName, email, phone, dialCode, consent flags, banned, uid)
+ * 3. Backfills "jobs":
+ *    - Sets companyId = employerUid || doc.id (if missing)
+ *    - Sets employerUid = companyId
+ *    - Sets postedBy = employerUid (if missing)
+ *    - Sets applicants = 0 (if missing)
+ * 4. Backfills "projects":
+ *    - Sets companyId = employerUid || doc.id (if missing)
+ *    - Sets employerUid = companyId
+ *    - Sets postedBy = employerUid (if missing)
+ *    - Sets applicants = 0 (if missing)
+ * 5. Backfills "applications":
+ *    - Sets companyId = employerUid (if missing)
+ * 6. Backfills "conversations":
+ *    - Finds employer participant and backfills companyId and companyName (if missing)
+ */
+
+import { initializeApp, cert, getApps } from "firebase-admin/app";
+import { getFirestore } from "firebase-admin/firestore";
+import fs from "fs";
+import path from "path";
+
+const isDryRun = process.argv.includes("--dry-run");
+
+// Parse service account arg if provided
+const saArg = process.argv.find((arg) => arg.startsWith("--service-account="));
+const saPath = saArg ? saArg.split("=")[1] : null;
+
+function loadEnvLocal() {
+  const envPath = path.resolve(process.cwd(), ".env.local");
+  if (fs.existsSync(envPath)) {
+    const lines = fs.readFileSync(envPath, "utf-8").split("\n");
+    for (const line of lines) {
+      const trimmed = line.trim();
+      if (!trimmed || trimmed.startsWith("#")) continue;
+      const [key, ...vals] = trimmed.split("=");
+      if (key && !process.env[key]) {
+        process.env[key] = vals.join("=").replace(/^["']|["']$/g, "");
+      }
+    }
+  }
+}
+
+loadEnvLocal();
+
+function initAdmin() {
+  if (getApps().length) return getFirestore();
+
+  if (saPath && fs.existsSync(saPath)) {
+    const sa = JSON.parse(fs.readFileSync(saPath, "utf-8"));
+    initializeApp({ credential: cert(sa) });
+    return getFirestore();
+  }
+
+  if (
+    process.env.FIREBASE_ADMIN_PROJECT_ID &&
+    process.env.FIREBASE_ADMIN_CLIENT_EMAIL &&
+    process.env.FIREBASE_ADMIN_PRIVATE_KEY
+  ) {
+    const privateKey = Buffer.from(
+      process.env.FIREBASE_ADMIN_PRIVATE_KEY,
+      "base64",
+    ).toString("utf8");
+    initializeApp({
+      credential: cert({
+        projectId: process.env.FIREBASE_ADMIN_PROJECT_ID,
+        clientEmail: process.env.FIREBASE_ADMIN_CLIENT_EMAIL,
+        privateKey,
+      }),
+    });
+    return getFirestore();
+  }
+
+  if (process.env.GOOGLE_APPLICATION_CREDENTIALS) {
+    initializeApp();
+    return getFirestore();
+  }
+
+  if (process.env.NEXT_PUBLIC_FIREBASE_PROJECT_ID) {
+    initializeApp({ projectId: process.env.NEXT_PUBLIC_FIREBASE_PROJECT_ID });
+    return getFirestore();
+  }
+
+  throw new Error(
+    "Could not initialize firebase-admin. Please provide --service-account=path/to/key.json or set GOOGLE_APPLICATION_CREDENTIALS.",
+  );
+}
+
+async function runMigration() {
+  console.log(`\n========================================`);
+  console.log(` Starting Employer Teams Migration`);
+  console.log(` Mode: ${isDryRun ? "DRY RUN (No writes)" : "LIVE EXECUTION"}`);
+  console.log(`========================================\n`);
+
+  const db = initAdmin();
+
+  // 1. Migrate employers
+  console.log("==> Step 1: Scanning 'employers' collection...");
+  const employersSnap = await db.collection("employers").get();
+  let employersUpdated = 0;
+  const employerMap = new Map(); // uid -> data
+
+  for (const doc of employersSnap.docs) {
+    const data = doc.data();
+    employerMap.set(doc.id, { id: doc.id, ...data });
+
+    const updates = {};
+    if (!data.companyId) updates.companyId = doc.id;
+    if (!data.companyRole) updates.companyRole = "Owner";
+    if (!data.status) updates.status = "active";
+
+    if (Object.keys(updates).length > 0) {
+      employersUpdated++;
+      console.log(`  [employers/${doc.id}] Add: ${JSON.stringify(updates)}`);
+      if (!isDryRun) {
+        await doc.ref.set(updates, { merge: true });
+      }
+    }
+  }
+  console.log(
+    `  Scanned ${employersSnap.size} employers. ${employersUpdated} needed backfill.\n`,
+  );
+
+  // 2. Backfill companies
+  console.log("==> Step 2: Backfilling 'companies' collection...");
+  let companiesCreated = 0;
+  for (const [uid, emp] of employerMap.entries()) {
+    const companyId = emp.companyId || uid;
+    // Only create company doc for owners or primary companyId
+    if (emp.companyRole && emp.companyRole !== "Owner" && companyId !== uid) {
+      continue;
+    }
+
+    const companyDocRef = db.collection("companies").doc(companyId);
+    const existingCompSnap = await companyDocRef.get();
+
+    if (!existingCompSnap.exists) {
+      companiesCreated++;
+      // Copy ONLY public company-level fields
+      const companyPayload = {
+        company: emp.company || emp.companyName || "",
+        website: emp.website || "",
+        logo:
+          emp.profilePicture ||
+          emp.profilePhoto ||
+          emp.logo ||
+          emp.photoURL ||
+          "",
+        description: emp.description || "",
+        industry: emp.industry || "",
+        location: emp.location || "",
+        verified: Boolean(emp.verified),
+        createdAt: emp.createdAt || new Date().toISOString(),
+        updatedAt: new Date().toISOString(),
+      };
+
+      console.log(
+        `  [companies/${companyId}] Create: ${JSON.stringify(companyPayload)}`,
+      );
+      if (!isDryRun) {
+        await companyDocRef.set(companyPayload);
+      }
+    }
+  }
+  console.log(`  Created ${companiesCreated} missing company documents.\n`);
+
+  // 3. Migrate jobs
+  console.log("==> Step 3: Scanning 'jobs' collection...");
+  const jobsSnap = await db.collection("jobs").get();
+  let jobsUpdated = 0;
+
+  for (const doc of jobsSnap.docs) {
+    const data = doc.data();
+    const updates = {};
+
+    const targetCompanyId = data.companyId || data.employerUid || doc.id;
+    if (!data.companyId) updates.companyId = targetCompanyId;
+    if (data.employerUid !== targetCompanyId)
+      updates.employerUid = targetCompanyId;
+    if (!data.postedBy) updates.postedBy = data.employerUid || null;
+    if (data.applicants === undefined || data.applicants === null) {
+      updates.applicants = 0;
+    }
+
+    if (Object.keys(updates).length > 0) {
+      jobsUpdated++;
+      console.log(`  [jobs/${doc.id}] Add: ${JSON.stringify(updates)}`);
+      if (!isDryRun) {
+        await doc.ref.set(updates, { merge: true });
+      }
+    }
+  }
+  console.log(
+    `  Scanned ${jobsSnap.size} jobs. ${jobsUpdated} needed backfill.\n`,
+  );
+
+  // 4. Migrate projects
+  console.log("==> Step 4: Scanning 'projects' collection...");
+  const projectsSnap = await db.collection("projects").get();
+  let projectsUpdated = 0;
+
+  for (const doc of projectsSnap.docs) {
+    const data = doc.data();
+    const updates = {};
+
+    const targetCompanyId = data.companyId || data.employerUid || doc.id;
+    if (!data.companyId) updates.companyId = targetCompanyId;
+    if (data.employerUid !== targetCompanyId)
+      updates.employerUid = targetCompanyId;
+    if (!data.postedBy) updates.postedBy = data.employerUid || null;
+    if (data.applicants === undefined || data.applicants === null) {
+      updates.applicants = 0;
+    }
+
+    if (Object.keys(updates).length > 0) {
+      projectsUpdated++;
+      console.log(`  [projects/${doc.id}] Add: ${JSON.stringify(updates)}`);
+      if (!isDryRun) {
+        await doc.ref.set(updates, { merge: true });
+      }
+    }
+  }
+  console.log(
+    `  Scanned ${projectsSnap.size} projects. ${projectsUpdated} needed backfill.\n`,
+  );
+
+  // 5. Migrate applications
+  console.log("==> Step 5: Scanning 'applications' collection...");
+  const appsSnap = await db.collection("applications").get();
+  let appsUpdated = 0;
+
+  for (const doc of appsSnap.docs) {
+    const data = doc.data();
+    const updates = {};
+
+    if (!data.companyId && data.employerUid) {
+      updates.companyId = data.employerUid;
+    }
+
+    if (Object.keys(updates).length > 0) {
+      appsUpdated++;
+      console.log(`  [applications/${doc.id}] Add: ${JSON.stringify(updates)}`);
+      if (!isDryRun) {
+        await doc.ref.set(updates, { merge: true });
+      }
+    }
+  }
+  console.log(
+    `  Scanned ${appsSnap.size} applications. ${appsUpdated} needed backfill.\n`,
+  );
+
+  // 6. Migrate conversations
+  console.log("==> Step 6: Scanning 'conversations' collection...");
+  const convsSnap = await db.collection("conversations").get();
+  let convsUpdated = 0;
+
+  for (const doc of convsSnap.docs) {
+    const data = doc.data();
+    const participants = data.participants || [];
+    const updates = {};
+
+    if (!data.companyId || !data.companyName) {
+      // Find the participant that corresponds to an employer
+      for (const pUid of participants) {
+        const emp = employerMap.get(pUid);
+        if (emp) {
+          if (!data.companyId) updates.companyId = emp.companyId || pUid;
+          if (!data.companyName)
+            updates.companyName = emp.company || emp.companyName || "";
+          break;
+        }
+      }
+    }
+
+    if (Object.keys(updates).length > 0) {
+      convsUpdated++;
+      console.log(
+        `  [conversations/${doc.id}] Add: ${JSON.stringify(updates)}`,
+      );
+      if (!isDryRun) {
+        await doc.ref.set(updates, { merge: true });
+      }
+    }
+  }
+  console.log(
+    `  Scanned ${convsSnap.size} conversations. ${convsUpdated} needed backfill.\n`,
+  );
+
+  console.log(`========================================`);
+  console.log(
+    ` Migration Completed Successfully${isDryRun ? " (DRY RUN)" : ""}.`,
+  );
+  console.log(`========================================\n`);
+}
+
+runMigration().catch((err) => {
+  console.error("Migration failed:", err);
+  process.exit(1);
+});
